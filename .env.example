# ---------------------------------------------------------------------------
# EL CLÁSICO — variables de entorno
# Copiá este archivo como .env.local y completá las credenciales.
# La web funciona sin ninguna variable: usa los datos mock de lib/mock-data.ts.
# ---------------------------------------------------------------------------

# URL pública del sitio (metadata, links absolutos, emails).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings > API
# Sin estas dos variables el sitio corre en modo mock.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo se usa del lado del servidor (uploads del panel / tareas administrativas).
# NUNCA exponer con el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Emails del formulario de contacto (Resend)
# Sin RESEND_API_KEY el formulario responde OK en desarrollo y falla en producción.
RESEND_API_KEY=
CONTACT_TO_EMAIL=contacto@elclasico.com
CONTACT_FROM_EMAIL=El Clásico <web@elclasico.com>

# Acceso al panel /admin
# Emails habilitados (separados por coma) cuando se usa el login de Supabase.
ADMIN_EMAILS=contacto@elclasico.com
