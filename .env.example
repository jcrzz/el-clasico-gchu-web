# ---------------------------------------------------------------------------
# EL CLÁSICO — variables de entorno
# Copiá este archivo como .env.local y completá las credenciales.
# La web funciona sin ninguna variable: usa los datos mock de lib/mock-data.ts.
# ---------------------------------------------------------------------------

# URL pública del sitio (metadata, links absolutos, emails).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings > API
# Sin estas dos variables el sitio corre en modo mock y /admin usa el modo demo
# sólo en desarrollo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sólo servidor. Habilita escritura en /admin, lecturas administrativas y
# uploads firmados a Storage. NUNCA exponer con el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Buckets públicos de Storage (deben existir; ver supabase/schema.sql).
SUPABASE_GALLERY_BUCKET=gallery
SUPABASE_PRESS_BUCKET=press
SUPABASE_SUPPORT_BUCKET=support

# Audio de la discografía (opcional).
# Sin esta variable, cada tema resuelve a /public/audio/<disco>/<pista>.<ext>
# (.mp3, .m4a, .ogg y .wav). Si el archivo no existe, la UI muestra
# el estado AUDIO PENDIENTE.
# Para Storage/CDN (Supabase Storage, R2, S3...), apuntá a la carpeta pública:
# AUDIO_BASE_URL=https://<project>.supabase.co/storage/v1/object/public/audio
AUDIO_BASE_URL=
# Extensión usada cuando AUDIO_BASE_URL está definido (default mp3).
AUDIO_EXTENSION=mp3

# Emails del formulario de contacto (Resend)
# Sin RESEND_API_KEY el formulario responde OK en desarrollo y falla en
# producción. CONTACT_FROM_EMAIL debe ser un remitente verificado en Resend.
RESEND_API_KEY=
CONTACT_TO_EMAIL=contacto@elclasico.com
CONTACT_FROM_EMAIL=El Clásico <web@elclasico.com>

# Acceso al panel /admin
# Emails habilitados (separados por coma) para el login de Supabase.
# En producción es obligatorio: si queda vacío, nadie puede entrar al panel.
ADMIN_EMAILS=contacto@elclasico.com
